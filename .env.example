# Plantilla de entorno. Copiar a .env y completar. Valores por defecto pensados para PRODUCCIÓN.
# En desarrollo local cambie: APP_ENV=local, APP_DEBUG=true, LOG_LEVEL=debug, SESSION_SECURE_COOKIE=false.
# Tras cambiar el .env en producción: php artisan config:cache

APP_NAME="System PL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://tu-dominio.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

# Proxies de confianza (ver config/trustedproxy.php). cloudflared local => 127.0.0.1,::1
# Nunca usar "*": permitiría falsear la IP (X-Forwarded-For) y evadir el rate limit de login.
TRUSTED_PROXIES=127.0.0.1,::1
# true solo si el servidor recibe tráfico directo desde la red de Cloudflare (sin túnel).
TRUSTED_PROXIES_CLOUDFLARE=false

# Logs: archivos diarios en storage/logs, 14 días de retención.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_QUERIES=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=system_pl
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# La app se sirve por HTTPS (Cloudflare Tunnel): la cookie de sesión solo viaja por HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# database o redis: necesario para rate limit e idempotencia de la cola offline (caché compartida y persistente).
CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Debugbar (solo require-dev). Desactivado por defecto; además AppServiceProvider lo fuerza
# a false si APP_ENV no es local/testing.
DEBUGBAR_ENABLED=false

# Seguridad (config/security.php)
SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_REPORT_ONLY=false
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_USER=10
RATE_LIMIT_LOGIN_USER_HOUR=50
RATE_LIMIT_WEB=120
RATE_LIMIT_IMPORTS=10
RATE_LIMIT_DESTRUCTIVE=8

# Notificación de ingresos por correo (config/registro.php)
REGISTRO_INGRESO_MAIL_ENABLED=false
REGISTRO_INGRESO_MAIL_TO=
REGISTRO_INGRESO_MAIL_SKIP_AJUSTE=true

# Power Automate (config/power_automate.php)
POWER_AUTOMATE_ENABLED=false
POWER_AUTOMATE_UPLOAD_URL=
POWER_AUTOMATE_API_KEY=
POWER_AUTOMATE_VERIFY_SSL=true
POWER_AUTOMATE_TIMEOUT=25
POWER_AUTOMATE_MAX_UPLOAD_KB=10240
